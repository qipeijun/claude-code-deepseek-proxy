# 本地代理密码。
# Claude Code 的 ANTHROPIC_API_KEY 要填同一个值。
LOCAL_PROXY_API_KEY=sk-f216dd5288a14db0ad4416a93d885382

# DeepSeek API Key。
# 你日常只需要把这里替换成真实 key，就可以直接启动。
DEEPSEEK_API_KEY=sk-f216dd5288a14db0ad4416a93d885382

# 可选：自定义配置文件路径。
# 不填时会优先读取 ./config.yaml；如果没有 config.yaml，则使用内置默认配置。
# PROXY_CONFIG=config.yaml

# 可选：备用 Anthropic 兼容映射服务。
# 默认配置不会用到它；只有你在 config.yaml 里配置 mapper provider/fallback 时才需要填写。
# MAPPER_BASE_URL=https://your-mapper.example.com
# MAPPER_API_KEY=sk-your-mapper-key
